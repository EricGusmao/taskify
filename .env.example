# Database (MySQL)
# When running inside Docker Compose, use hostname "mysql".
# When running Go locally (outside Docker), change "mysql" to "localhost".
MYSQL_ROOT_PASSWORD=taskify_root_pass
MYSQL_DATABASE=taskify
MYSQL_USER=taskify
MYSQL_PASSWORD=taskify_pass
DATABASE_DSN=taskify:taskify_pass@tcp(mysql:3306)/taskify?charset=utf8mb4&parseTime=True&loc=Local

# Server
PORT=8080

# JWT — must be at least 64 characters
JWT_SECRET=this-is-a-development-only-jwt-secret-that-is-at-least-sixty-four-characters-long

# Avatar uploads (path inside the container; mapped to the "uploads" Docker volume)
UPLOAD_PATH=/uploads/avatars
